# Client-visible Supabase values. These are required at build time by Vercel and Render.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only Supabase values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI provider used by the existing review server function.
LOVABLE_API_KEY=your_lovable_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# GitHub OAuth and at-rest token encryption. Generate GITHUB_TOKEN_ENC_KEY with a
# cryptographically random value and keep it stable after accounts are connected.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_TOKEN_ENC_KEY=replace_with_a_long_random_secret

# Deployment URLs, used for provider dashboard configuration and documentation.
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-api.onrender.com

# Not used by this Supabase-authenticated application. Kept as placeholders only
# when an external integration requires them; do not create values unnecessarily.
DATABASE_URL=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_ANON_KEY=
API_BASE_URL=
